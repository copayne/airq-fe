# Development Environment Configuration
# This file is loaded automatically in development mode

# GraphQL API Configuration - Development
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://127.0.0.1:5000/graphql

# Polling and Real-time Updates - More frequent for development
NEXT_PUBLIC_POLL_INTERVAL_MS=15000

# UI Configuration - Faster feedback in development
NEXT_PUBLIC_DEBOUNCE_DELAY_MS=200

# Development-specific settings
NODE_ENV=development