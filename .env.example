# Environment Variables Example
# Copy this file to .env.local and update with your actual values

# GraphQL API Configuration
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://127.0.0.1:5000/graphql

# Polling and Real-time Updates
NEXT_PUBLIC_POLL_INTERVAL_MS=30000

# UI Configuration
NEXT_PUBLIC_DEBOUNCE_DELAY_MS=300

# Optional: Sensor Data Range Defaults (if not set, hardcoded defaults are used)
# NEXT_PUBLIC_DEFAULT_MIN_CO2=0
# NEXT_PUBLIC_DEFAULT_MAX_CO2=5000
# NEXT_PUBLIC_DEFAULT_MIN_TEMP=-20
# NEXT_PUBLIC_DEFAULT_MAX_TEMP=50
# NEXT_PUBLIC_DEFAULT_MIN_HUMIDITY=0
# NEXT_PUBLIC_DEFAULT_MAX_HUMIDITY=100

# Development
NODE_ENV=development

# Skip environment validation (useful for Docker builds)
# SKIP_ENV_VALIDATION=true