# Production Environment Configuration
# This file is loaded automatically in production builds

# GraphQL API Configuration - Production
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://your-production-api.com/graphql

# Polling and Real-time Updates - Less frequent for production efficiency
NEXT_PUBLIC_POLL_INTERVAL_MS=60000

# UI Configuration - Standard debounce for production
NEXT_PUBLIC_DEBOUNCE_DELAY_MS=500

# Production-specific settings
NODE_ENV=production