# Staging Environment Configuration  
# This file can be used for staging deployments

# GraphQL API Configuration - Staging
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://staging-api.your-domain.com/graphql

# Polling and Real-time Updates - Moderate frequency for staging
NEXT_PUBLIC_POLL_INTERVAL_MS=30000

# UI Configuration - Standard debounce for staging
NEXT_PUBLIC_DEBOUNCE_DELAY_MS=300

# Staging-specific settings
NODE_ENV=production